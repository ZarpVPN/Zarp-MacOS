<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.zarp.mac.zarpd</string>
	<key>Program</key>
	<string>/Applications/Zarp.app/Contents/MacOS/zarpd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Zarp.app/Contents/MacOS/zarpd</string>
	</array>
